{
  "nome": "Jarvis",
  "usuario": "Lucas",
  "palavras_chave": ["jarvis", "jarbas", "jarvas", "jervis", "javis", "jarvi", "jarves", "harvis", "garvis"],
  "semelhanca_minima": 0.75,
  "idioma": "pt-BR",
  "saudacao": ["{periodo}, {usuario}. Tô online.", "{periodo}, {usuario}. Pronto quando precisar."],
  "respostas_ativacao": ["{periodo}, {usuario}. O que deseja?", "{periodo}, {usuario}. Em que posso ajudar hoje?", "{periodo}. Às suas ordens.", "{periodo}, {usuario}. Pode falar.", "{periodo}! Estou aqui. O que manda?"],
  "iniciar_com_windows": true,

  "persona": [
    "Você trabalha para {usuario} e já o conhece bem: use o que sabe dele com naturalidade, sem ficar dizendo que tem anotado.",
    "Personalidade: calmo, confiante e leal, com humor seco e inteligente. Uma ironia leve de vez em quando cai bem; nunca force piada e nunca brinque com assunto sério.",
    "Fale como gente, não como manual: português do Brasil natural e fluido, coloquial na medida ('tá', 'pra', 'beleza' são bem-vindos). Frases completas, com ritmo de conversa.",
    "Chame {usuario} pelo nome de vez em quando, não em toda resposta.",
    "Vá direto ao ponto: nada de 'Claro!', 'Com certeza!', 'Ótima pergunta' nem repetir o pedido antes de responder.",
    "Tenha opinião. Se ele perguntar o que você acha, diga o que acha e por quê, em poucas palavras.",
    "Seja proativo sem ser chato: se notar algo útil (um risco, um jeito melhor, algo que ele esqueceu), mencione em uma frase.",
    "Seja honesto: nunca invente. Se não sabe ou não conseguiu, diga isso e ofereça verificar."
  ],

  "voz": {
    "nome": "pt-BR-AntonioNeural",
    "velocidade": "+8%",
    "tom": "-4Hz",
    "volume": "+0%"
  },

  "microfone": {
    "dispositivo": null,
    "limiar_minimo": 20,
    "fator_ruido": 2.6,
    "silencio_fim_s": 1.2,
    "max_frase_s": 15,
    "fala_minima_s": 0.3
  },

  "transcricao": {
    "motor": "auto",
    "modelo": "small",
    "gpu": "auto",
    "reserva": true
  },

  "conversa": {
    "janela_seguimento_s": 8,
    "max_caracteres_fala": 600,
    "historico_turnos": 10,
    "nova_conversa_apos_min": 720,
    "previa_quando_demora": true
  },

  "motor_padrao": "auto",

  "nemotron": {
    "url": "https://integrate.api.nvidia.com/v1",
    "modelo": "nvidia/nemotron-3.5-lightning-30b-a3b",
    "raciocinio": false,
    "temperatura": 0.5,
    "max_tokens": 700,
    "timeout_s": 30
  },

  "claude": {
    "modelo": "sonnet",
    "permissao": "auto",
    "pasta_trabalho": ["~/iCloudDrive/Documentos/Data", "~/OneDrive/Documentos/Data", ".."],
    "usar_mcp": false,
    "modo_limpo": true,
    "contas": ["", "~/.claude-conta2"],
    "timeout_s": 300
  },

  "nvidia_pro": {
    "ativo": true,
    "rotulo": "Kimi",
    "apelidos": ["kimi"],
    "modelo": "moonshotai/kimi-k3.1-pro",
    "raciocinio": null,
    "temperatura": 0.4,
    "max_tokens": 900,
    "timeout_s": 45,
    "lento": true
  },

  "motores_extras": {
    "gemini": {
      "ativo": true, "rotulo": "Gemini", "apelidos": ["gemini", "jemini", "gemine"],
      "comando": ["gemini", "-o", "json", "-p", " "], "saida_json": "response", "timeout_s": 120,
      "login_arquivo": "~/.gemini/settings.json", "login_contem": "selectedType"
    },
    "codex": {
      "ativo": true, "rotulo": "Codex", "apelidos": ["codex", "codecs", "chatgpt", "gpt"],
      "comando": ["codex", "exec", "--skip-git-repo-check", "-s", "workspace-write", "-c", "model_reasoning_effort=low", "-"], "timeout_s": 180,
      "login_arquivo": "~/.codex/auth.json", "login_contem": "tokens"
    }
  },

  "roteamento": {
    "rapido": ["claude", "nemotron", "gemini"],
    "inteligente": ["claude", "nvidia_pro", "gemini", "nemotron"],
    "internet": ["claude", "gemini"],
    "pc": ["claude", "codex", "gemini"]
  },

  "interface": {
    "popup": true,
    "esconder_apos_s": 2.5
  }
}
